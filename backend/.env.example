# Copy this file to .env and edit. Never commit .env.
# Leave DATABASE_URL empty to use local SQLite (backend/ecotrack.db).
# Production example: postgresql://user:password@host:5432/dbname
DATABASE_URL=
# Comma-separated list of allowed frontend origins (production: your Vercel URL).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional. Without it the rule-based recommendation engine is used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
